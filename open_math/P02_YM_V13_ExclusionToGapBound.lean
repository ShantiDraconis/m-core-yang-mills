import MCore.YangMills.A1.GapConcreteV13
import MCore.SpectralExclusion

namespace MCore.YangMills.A1

/--
P02-YM V13: the single remaining material producer.

The spectral exclusion premise is already generated by V9/V10.  Physical
coverage was closed by V11.  What remains is the analytic same-H implication
from exclusion of spectral mass below m to the concrete quadratic-form gap.
-/
theorem exclusionToGapBound_concrete_V13
    (D : RealEnergyModelV13)
    (H : MCore.K14HamiltonianOperator D.toK14)
    (S : MCore.SpectralExclusionRealization) :
    (∀ r : ℝ,
      0 ≤ r →
      r < S.decay.m →
      S.spectral.massBelow r = 0) →
    ∀ (psi : D.State) (hpsi : H.domain psi),
      D.physical psi →
      D.orthogonalToVacuum psi →
      (YMGapConcreteV13 D).gapBound
        S.decay.m psi (H.act psi hpsi) := by
  intro hexcl psi hpsi hphys horth
  change
    S.decay.m * D.normSq psi ≤
      D.energyPairing psi (H.act psi hpsi)
  /-
  OPEN_MATH.

  The next kernel-visible analytic layer must identify:
  1. S.spectral.massBelow with the spectral measure of this same H and psi;
  2. D.normSq psi with total spectral mass;
  3. D.energyPairing psi (H.act psi hpsi) with the first spectral moment;
  4. low-spectrum exclusion with support in [S.decay.m, infinity);
  5. the resulting integral inequality
       m * integral 1 dmu <= integral lambda dmu.
  -/
  sorry

end MCore.YangMills.A1
